# Copie para BackEnd/.env e ajuste (não versionar .env).
# O app carrega este arquivo automaticamente no startup (BackEnd/env_loader.py),
# sem sobrescrever variáveis já definidas no shell/ambiente.
# Documentadas em BackEnd/app.py e docs/AMBIENTES.md

# Basename em DAL/arquivos_crip/arq/ (arquivo map.dat → "map")
# Credenciais do SGBD NÃO ficam em DB_HOST/DB_USER/etc.:
# estão criptografadas em DAL/arquivos_crip/arq/*.dat (servidor, porta, bd, usuario, senha).
#
# --- Lab local PostgreSQL (sem Docker, sem MariaDB) ---
#   REDMAPA_SGBD=postgresql
#   REDMAPA_CONFIG=map_PostGree
#   ERP_PROVIDER=mock
#   Host tipico: 127.0.0.1:5433  → gerar .dat com:
#     scripts/setup_postgresql_local.ps1  (ou .py)
#
# --- Empresa (MariaDB canônico) ---
#   REDMAPA_SGBD=mariadb
#   REDMAPA_CONFIG=map
#   ERP_PROVIDER=oracle
#
# Sem fallback silencioso entre MariaDB e PostgreSQL: SGBD + .dat devem coincidir.
REDMAPA_CONFIG=map_PostGree

# Ambiente: development | staging | production
# production + ERP_PROVIDER=mock → falha no startup (sem fallback silencioso).
REDMAPA_ENV=development

# mariadb | postgresql (empresa: mariadb | PC local: postgresql)
REDMAPA_SGBD=postgresql

# Provider explícito do cadastro corporativo:
# - mock: desenvolvimento/teste local (recomendado no PC)
# - oracle: consulta Oracle/ERP corporativo (preferência: erp.dat) — só backend
# - disabled: desabilita consulta corporativa
# Frontend nunca acessa Oracle. HTTP: 200 encontrado | 404 não encontrado | 503 indisponível.
ERP_PROVIDER=mock
ERP_ALLOW_MANUAL_USER_CREATE=0

# Compat legado (mantido por transição). Prefira ERP_PROVIDER.
# Com ERP_PROVIDER=mock use 0.
REDMAPA_ERP_ENABLED=0

# Oracle via config criptografada (recomendado):
#   DAL/arquivos_crip/arq/erp.dat + DAL/arquivos_crip/chave/chave.key
REDMAPA_ERP_CONFIG=erp
REDMAPA_ERP_SGBD=oracle

# Alternativa: Oracle/ERP por variáveis de ambiente (se não houver erp.dat).
# Use ERP_ORACLE_DSN ou host+porta+service_name.
# ERP_ORACLE_DSN=host:1521/service_name?transport_connect_timeout=5&expire_time=1
# ERP_ORACLE_HOST=oracle.exemplo.local
# ERP_ORACLE_PORT=1521
# ERP_ORACLE_SERVICE_NAME=ORCL
# ERP_ORACLE_USER=usuario_erp
# ERP_ORACLE_PASSWORD=troque-isto
# ERP_ORACLE_TIMEOUT_MS=5000
# ERP_ORACLE_POOL_MIN=1
# ERP_ORACLE_POOL_MAX=4
# ERP_ORACLE_POOL_INCREMENT=1

# true em produção com HTTPS (cookies Secure)
REDMAPA_COOKIE_SECURE=false
# lax | strict | none (none exige Secure=true; front em domínio distinto)
REDMAPA_COOKIE_SAMESITE=lax

# Origens CORS explícitas (vírgula). Nunca use *.
REDMAPA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Métricas: defina token e envie header X-Metrics-Token
# REDMAPA_METRICS_TOKEN=gere-um-token-longo
# REDMAPA_METRICS_PUBLIC=0

# Bind da API Flask (dev). Produção: Gunicorn atrás de proxy reverso.
REDMAPA_HOST=127.0.0.1
REDMAPA_PORT=5000

# Fuso operacional (banco de horas / datas)
TZ=America/Sao_Paulo

# 1 | true | yes → debug Flask (proibido com REDMAPA_ENV=production)
FLASK_DEBUG=1
